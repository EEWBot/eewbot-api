# The public key of a *separate test Discord Application*.
# Never set the production Application's Interactions Endpoint URL at this stage.
DISCORD_PUBLIC_KEY=REPLACE_WITH_TEST_APPLICATION_PUBLIC_KEY
DISCORD_COMMANDS_ENABLED=false
DISCORD_APPLICATION_ID=REPLACE_WITH_TEST_APPLICATION_ID
# Set only the TEST application's bot token, locally or as a staging Worker Secret.
DISCORD_BOT_TOKEN=REPLACE_WITH_TEST_BOT_TOKEN

# Internal reads fail closed unless ACCESS_AUD and a trusted native Access context
# both exist. See README for actual staging setup or isolated local simulation.
# Internal read credentials belong to the caller, not Worker bindings.
# Cleanup uses the same ACCESS_AUD and native context as reads. Missing common
# configuration fails closed for both. See docs/cleanup-api.md.

# Optional outbound Sender; independent of Internal/Core Access credentials.
# URL is an HTTP/HTTPS origin. Access is an optional pair and requires HTTPS.
# The real URL is private: keep it in ignored .dev.vars or a Worker Secret.
WEBHOOK_SENDER_URL=
WEBHOOK_SENDER_ACCESS_CLIENT_ID=
WEBHOOK_SENDER_ACCESS_CLIENT_SECRET=
WEBHOOK_SENDER_AUTH_TOKEN=REPLACE_WITH_SENDER_BEARER_TOKEN
