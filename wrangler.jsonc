{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eewbot-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      "vars": {
        "MIGRATION_API_ENABLED": "false",
        "DISCORD_APPLICATION_ID": "350178549782544384"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "eewbot-staging",
          "database_id": "ce251ea8-e486-48f2-a13b-8e24a4bc92bf",
          "migrations_dir": "migrations"
        }
      ],
      "routes": [
        {
          "pattern": "api-staging.eewbot.net",
          "custom_domain": true
        }
      ]
    },
    "production": {
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      "vars": {
        "MIGRATION_API_ENABLED": "false",
        "DISCORD_APPLICATION_ID": "329257498668302346"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "eewbot-production",
          "database_id": "c6e64012-9101-4e2d-be6b-3e272794b2c8",
          "migrations_dir": "migrations"
        }
      ],
      "routes": [
        {
          "pattern": "api.eewbot.net",
          "custom_domain": true
        }
      ]
    }
  }
}
