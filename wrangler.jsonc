{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eewbot-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "env": {
    "staging": {
      "workers_dev": false,
      "routes": [
        {
          "pattern": "api-staging.eewbot.net",
          "custom_domain": true
        }
      ]
    },
    "production": {
      "workers_dev": false,
      "routes": [
        {
          "pattern": "api.eewbot.net",
          "custom_domain": true
        }
      ]
    }
  }
}
