{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eewbot-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "env": {
    "staging": {
      "workers_dev": false,
      "vars": {
        "DISCORD_COMMANDS_ENABLED": "true",
        "DISCORD_APPLICATION_ID": "350178549782544384",
        "DISCORD_TEST_GUILD_ID": "564550533973540885"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "eewbot-staging",
          "database_id": "30988518-b77a-4f66-806e-52f266a2aeda",
          "migrations_dir": "migrations"
        }
      ],
      "routes": [
        {
          "pattern": "api-staging.eewbot.net",
          "custom_domain": true
        }
      ]
    },
    "production": {
      "workers_dev": false,
      "routes": [
        {
          "pattern": "api.eewbot.net",
          "custom_domain": true
        }
      ]
    }
  }
}
