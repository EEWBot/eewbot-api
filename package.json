{
  "name": "eewbot-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --env staging",
    "check": "tsc --noEmit",
    "test": "node --test test/*.node.mjs && vitest run",
    "test:d1": "vitest run test/d1-destination-store.test.ts",
    "test:java": "node scripts/test-java-core.mjs && node scripts/test-java-quakeinfo.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --env staging --local",
    "db:migrate:staging": "node scripts/check-staging-d1.mjs && wrangler d1 migrations apply DB --env staging --remote",
    "build": "npm run build:staging && npm run build:production",
    "build:staging": "wrangler deploy --env staging --dry-run --outdir dist/staging",
    "build:production": "wrangler deploy --env production --dry-run --outdir dist/production",
    "deploy:staging": "node scripts/check-staging-d1.mjs && wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "register:test-command": "node scripts/register-test-command.mjs"
  },
  "dependencies": {
    "discord-interactions": "4.4.0",
    "hono": "4.13.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "5.20261030.1",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "miniflare": "5.20261019.2-beta",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.155.0"
  }
}
